    "signerCustody": {
      "type": "object",
      "properties": {
        "sponsor": {
          "type": "object",
          "properties": {
            "uid": {
              "type": "integer",
              "minimum": 0
            },
            "gid": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "uid",
            "gid"
          ],
          "additionalProperties": false
        },
        "mint": {
          "type": "object",
          "properties": {
            "uid": {
              "type": "integer",
              "minimum": 0
            },
            "gid": {
              "type": "integer",
              "minimum": 0
