{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Capture402 installation operational data",
  "description": "Documentation schema, not authority to install or accept a deployment. No actual repository ID or installation values ship. JSON Schema shape validation cannot replace root ownership, acceptance, source/artifact equality and per-consumer semantic checks.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "repository": {
      "const": "starPaw/capture402-solana"
    },
    "repositoryId": {
      "type": "integer",
      "minimum": 1
    },
    "repositoryPrivate": {
      "const": false
    },
    "deploymentRecordSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acceptedExecutableSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "e2eApplicationRelease": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "b3RecoverySourceSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "b3RecoveryPolicy": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 1
        },
        "order": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "payment": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "payer": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "orderSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "authorizeSignature": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
        },
        "originalEvidenceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "classification": {
          "const": "source-bound-pre-dispatch-refusal"
        },
        "action": {
          "const": "beer"
        }
      },
      "required": [
        "schema",
        "order",
        "payment",
        "payer",
        "sourceSha",
        "orderSha256",
        "authorizeSignature",
        "originalEvidenceSha256",
        "classification",
        "action"
      ],
      "additionalProperties": false
    },
    "authorizeAbandonPolicies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "schema": {
            "const": 1
          },
          "sourceSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "order": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "payment": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "payer": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "orderSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "consentSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
