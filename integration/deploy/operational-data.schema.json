                  "oldMaximum": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "oldUsed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "carryForward": {
                    "type": "integer",
                    "minimum": 0
