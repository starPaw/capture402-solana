    "paidPrekeySource": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "paidOrigin": {
      "type": "string",
      "pattern": "^https://[^/?#@]+$"
    },
    "nodeArchiveSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dependencyArchiveSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dependencyInventorySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nodeBinarySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nodeSourceUid": {
      "type": "integer",
      "minimum": 0
