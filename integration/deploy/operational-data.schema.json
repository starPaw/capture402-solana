    "campaignReference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "publicOrigin": {
      "type": "string",
      "pattern": "^https://[^/?#@]+$"
    },
    "devOrigin": {
      "type": "string",
      "pattern": "^https://[^/?#@]+$"
    },
    "e2eOrigin": {
      "type": "string",
      "pattern": "^https://[^/?#@]+$"
    },
    "sourceKeyPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "sourceKnownHostsPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "deploymentSshTarget": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "legacyReleaseRoot": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "nodeArchiveDirectory": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
