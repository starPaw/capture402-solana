            "uid",
            "gid"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sponsor",
        "mint"
      ],
      "additionalProperties": false
    },
    "acceptedExecutableSizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "admissionContracts": {
      "type": "object",
      "properties": {
        "orders": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n\\u0000]+$"
            },
            "initialMaximum": {
              "type": "integer",
              "minimum": 0
            },
            "migrations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "step": {
                    "enum": [
                      "expired-order",
                      "demo-runs"
                    ]
                  },
                  "archive": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9.-]+\\.lock$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\r\\n\\u0000]+$"
                  },
                  "oldMaximum": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "oldUsed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "carryForward": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "newMaximum": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "step",
                  "archive",
                  "reason",
                  "oldMaximum",
                  "oldUsed",
                  "carryForward",
                  "newMaximum"
