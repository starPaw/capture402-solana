        "required": [
          "schema",
          "sourceSha",
          "order",
          "payment",
          "payer",
          "orderSha256",
          "consentSha256"
        ],
        "additionalProperties": false
      }
    },
    "authorizeIsolationPolicy": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 1
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "order": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "payment": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "payer": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "orderSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "consentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "busySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "actionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "journalSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
        },
        "messageHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signedWireSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "sourceSha",
        "order",
        "payment",
        "payer",
        "orderSha256",
        "consentSha256",
        "busySha256",
        "actionSha256",
        "journalSha256",
        "signature",
        "messageHash",
        "signedWireSha256"
      ],
      "additionalProperties": false
    },
    "merchantDemoPolicy": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 1
        },
        "origin": {
          "type": "string",
          "pattern": "^https://[^/?#@]+$"
        },
        "network": {
          "type": "string",
          "pattern": "^solana:[-_a-zA-Z0-9]{1,32}$"
        },
        "programId": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "sponsor": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "merchant": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "mint": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "budget": {
          "const": "100000000"
