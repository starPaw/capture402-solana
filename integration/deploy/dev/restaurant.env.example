# Private /etc/capture402-dev/restaurant.env, root:root 0600.
# Service key is owned by capture402-dev-restaurant, mode 0600.
# Set the private QuickNode or Helius Devnet endpoint; keep credentials out of Git.
SOLANA_RPC_URL=
SAC006_BEARER_TOKEN=
SAC006_MERCHANT_TOKEN=
SAC006_DEPLOYMENT_RECORD_PATH=/etc/capture402/deployment-identity.v1.json
SAC006_FACILITATOR_URL=http://127.0.0.1:18887
SAC006_FEE_PAYER=
SAC006_SERVER_KEYPAIR_PATH=/etc/capture402-dev/keys/merchant.json
SAC006_STORE_DIR=/var/lib/capture402-dev/restaurant/operation-store
SAC006_RECLAIM_JOURNAL_DIR=/var/lib/capture402-dev/restaurant/reclaim
SAC006_ASSET_MINT=
SAC006_PUBLIC_ORIGIN=https://@DEV_HOST@
SAC006_HOST=127.0.0.1
SAC006_RESOURCE_PORT=18888
